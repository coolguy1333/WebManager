# WebManager dashboard listens locally; system Nginx exposes it on port 8080.
WEBMANAGER_DATA_DIR=/var/lib/webmanager
WEBMANAGER_HOST=127.0.0.1
WEBMANAGER_PORT=5000
WEBMANAGER_SITE_PORT_MIN=8100
WEBMANAGER_SITE_PORT_MAX=8999
WEBMANAGER_SITE_GATEWAY_PORT=8090
WEBMANAGER_SITE_BASE_DOMAIN=
WEBMANAGER_SITE_PUBLIC_SCHEME=http
WEBMANAGER_NGINX_BINARY=/usr/sbin/nginx
WEBMANAGER_TRUST_PROXY=1
WEBMANAGER_SESSION_COOKIE_SECURE=0
WEBMANAGER_GOOGLE_CLIENT_ID=
WEBMANAGER_GOOGLE_CLIENT_SECRET=
WEBMANAGER_GOOGLE_REDIRECT_URI=
WEBMANAGER_GOOGLE_ALLOWED_DOMAINS=
WEBMANAGER_GOOGLE_ALLOWED_EMAILS=
WEBMANAGER_AUTO_REFRESH_ENABLED=1
WEBMANAGER_AUTO_REFRESH_POLL_SECONDS=30
WEBMANAGER_MAX_REPOSITORY_MB=1024
# App hosting (containers). Turn on with: sudo bash deploy/debian/enable-apps.sh
WEBMANAGER_APPS_ENABLED=0
WEBMANAGER_CONTAINER_RUNTIME=
WEBMANAGER_APP_DEFAULT_MEMORY_MB=256
WEBMANAGER_APP_CPUS=0.5
WEBMANAGER_APP_START_TIMEOUT=60
# Multi-server mesh: the *other* WebManager servers to federate with (comma
# separated), and a shared secret sent as "Authorization: Bearer <token>"
# between them. Leave both blank to run standalone. Same token on every server.
WEBMANAGER_PEERS=
WEBMANAGER_PEER_TOKEN=
# Replication (requires WEBMANAGER_PEER_TOKEN above): set this to make this
# server a REPLICA that mirrors the named primary's config, sites, and app
# data instead of running standalone. Leave blank for a primary/standalone
# server. See the in-app Docs page ("Multi-server mesh") before turning
# this on - it changes what a restart does and how failover works.
WEBMANAGER_REPLICA_OF=
WEBMANAGER_DEBUG=0
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
GIT_TERMINAL_PROMPT=0
